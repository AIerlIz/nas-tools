# 构建上下文改为仓库根目录后，以下内容不应进入镜像
# 版本控制 / CI / 工具元数据
.git
.github
.workbuddy

# 注意：config/config.yaml 有意【不】列在这里 —— Docker 镜像与 PyInstaller 产物都
# 需要它作为首次启动的配置模板。前置条件是它必须始终是模板：本地开发请用仓库外的
# NASTOOL_CONFIG 启动（写入会落在仓库外那份），否则它会被填入真实 api_key / 密码哈希
# 并随产物一起发布。

# 运行期产物（与 .gitignore 保持一致）
config/user.db
config/media.db
config/tmdb.dat
config/logs
config/plugins
config/temp

# 构建产物与字节码
package/build
package/dist
**/__pycache__
*.pyc
